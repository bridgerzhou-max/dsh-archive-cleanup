{
  "name": "dsh-archive-cleanup",
  "version": "0.1.0",
  "type": "module",
  "description": "List and permanently delete archived sessions from the Harness settings page.",
  "author": "bridgerzhou-max",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridgerzhou-max/dsh-archive-cleanup.git"
  },
  "homepage": "https://github.com/bridgerzhou-max/dsh-archive-cleanup#readme",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "archive",
    "cleanup"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
